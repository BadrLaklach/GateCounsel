import json
with open('training_resources/enrichment/candidates/ssrf_b.jsonl', 'r') as f:
    lines = f.readlines()
print(f'Total lines: {len(lines)}')
for i, line in enumerate(lines):
    line = line.strip()
    if not line:
        print(f'Line {i+1}: EMPTY')
        continue
    try:
        data = json.loads(line)
        # Check structure
        assert 'messages' in data
        assert len(data['messages']) == 3
        assert data['messages'][0]['role'] == 'system'
        assert data['messages'][1]['role'] == 'user'
        assert data['messages'][2]['role'] == 'assistant'
        
        # Parse assistant content
        assistant_content = json.loads(data['messages'][2]['content'])
        required_keys = ['vuln_class', 'target_param', 'payload', 'injection_point', 'expected_success_signal', 'confidence', 'reasoning']
        assert list(assistant_content.keys()) == required_keys, f'Keys mismatch: {list(assistant_content.keys())}'
        assert assistant_content['vuln_class'] == 'ssrf'
        assert assistant_content['injection_point'] in ['query', 'body', 'header', 'cookie', 'path']
        assert 0.0 <= assistant_content['confidence'] <= 1.0
        print(f'Line {i+1}: OK - injection_point={assistant_content[\"injection_point\"]}, confidence={assistant_content[\"confidence\"]}')
    except Exception as e:
        print(f'Line {i+1}: ERROR - {e}')
print('Verification complete')
"
