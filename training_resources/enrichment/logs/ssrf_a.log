import json
p="training_resources/enrichment/candidates/ssrf_a.jsonl"
raw=open(p,encoding="utf-8").read()
lines=raw.splitlines()
print("lines:", len(lines))
print("ends_with_newline:", raw.endswith("\n"))
expected_keys=["vuln_class","target_param","payload","injection_point","expected_success_signal","confidence","reasoning"]
seen_pairs=set()
for i,l in enumerate(lines,1):
    obj=json.loads(l)
    assert list(obj.keys())==["messages"], (i,list(obj.keys()))
    msgs=obj["messages"]
    assert len(msgs)==3
    assert [m["role"] for m in msgs]==["system","user","assistant"]
    ac=json.loads(msgs[2]["content"])
    assert list(ac.keys())==expected_keys, (i,list(ac.keys()))
    assert ac["injection_point"] in {"query","body","header","cookie","path"}
    assert 0.0<=ac["confidence"]<=1.0
    assert ac["target_param"] in msgs[1]["content"].split("Endpoint: ")[1] if False else True
    # target param appears in endpoint line
    ep_line=[x for x in msgs[1]["content"].splitlines() if x.startswith("Endpoint:")][0]
    assert ac["target_param"].split()[0] in ep_line or ac["target_param"] in ep_line, (i,ac["target_param"],ep_line)
    pair=(ac["target_param"],ac["payload"])
    assert pair not in seen_pairs
    seen_pairs.add(pair)
print("all checks passed")
# injection_point distribution
from collections import Counter
c=Counter(json.loads(l)["messages"][2]["content"] and json.loads(json.loads(l)["messages"][2]["content"])["injection_point"] for l in lines)
print("injection_points:", dict(c))
