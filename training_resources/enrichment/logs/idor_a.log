    msgs = obj["messages"]
    assert len(msgs) == 3 and [m["role"] for m in msgs] == ["system","user","assistant"]
    assert msgs[0]["content"] == system, f"system mismatch line {i}"
    a = json.loads(msgs[2]["content"])
    assert list(a.keys()) == KEYS, f"key order line {i}"
    assert a["vuln_class"] == "idor"
    assert a["injection_point"] in {"query","body","header","cookie","path"}
    assert 0.0 <= a["confidence"] <= 1.0
    params.add(a["target_param"])
    points.append(a["injection_point"])
    pair = (a["target_param"], a["payload"])
    assert pair not in seen_pairs, f"dup pair line {i}"
    seen_pairs.add(pair)
    assert msgs[2]["content"] == json.dumps(a, ensure_ascii=False)

assert params == expected_params, params ^ expected_params
assert set(points) == {"query","body","header","cookie","path"}
assert len([p for p in points if p=="path"]) == 5
conf = [json.loads(l)["messages"][2]["content"] for l in []]
print("OK: 15 lines written and verified")
print("injection points:", {p: points.count(p) for p in sorted(set(points))})
