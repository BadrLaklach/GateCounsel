import json
with open('training_resources/enrichment/candidates/sqli_a.jsonl', 'r') as f:
    lines = f.readlines()
print(f'Total lines: {len(lines)}')
targets_payloads = set()
injection_points = set()
dbms_covered = set()
for i, line in enumerate(lines, 1):
    line = line.strip()
    if not line:
        print(f'Line {i}: EMPTY')
        continue
    try:
        obj = json.loads(line)
        messages = obj.get('messages', [])
        if len(messages) != 3:
            print(f'Line {i}: ERROR - Expected 3 messages, got {len(messages)}')
        roles = [m.get('role') for m in messages]
        if roles != ['system', 'user', 'assistant']:
            print(f'Line {i}: ERROR - Wrong role order: {roles}')
        assistant_content = messages[2].get('content', '')
        assistant_json = json.loads(assistant_content)
        keys = list(assistant_json.keys())
        expected_keys = ['vuln_class', 'target_param', 'payload', 'injection_point', 'expected_success_signal', 'confidence', 'reasoning']
        if keys != expected_keys:
            print(f'Line {i}: ERROR - Keys mismatch: {keys}')
        injection_point = assistant_json.get('injection_point')
        valid_points = ['query', 'body', 'header', 'cookie', 'path']
        if injection_point not in valid_points:
            print(f'Line {i}: ERROR - Invalid injection_point: {injection_point}')
        injection_points.add(injection_point)
        confidence = assistant_json.get('confidence')
        if not (0.0 <= confidence <= 1.0):
            print(f'Line {i}: ERROR - Confidence out of range: {confidence}')
        target = assistant_json.get('target_param')
        payload = assistant_json.get('payload')
        pair = (target, payload)
        if pair in targets_payloads:
            print(f'Line {i}: ERROR - Duplicate (target_param, payload): {pair}')
        targets_payloads.add(pair)
        print(f'Line {i}: OK - {target} | {injection_point} | conf={confidence} | {payload[:60]}...')
    except json.JSONDecodeError as e:
        print(f'Line {i}: Invalid JSON - {e}')

print(f'\\nUnique injection_points: {injection_points}')
print(f'Unique (target_param, payload) pairs: {len(targets_payloads)}')
